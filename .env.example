PORT=3333
DATABASE_URL=postgresql://brlift:brlift_local@localhost:5440/brlift
WEB_ORIGIN=http://localhost:5174
CORS_ALLOW_ALL_ORIGINS=false
TRUST_PROXY=0
STORAGE_DIR=./storage
STORAGE_WRITE_BACKEND=local
STORAGE_READ_BACKENDS=local
DOCUMENT_CONCURRENCY=1
MEDIA_UPLOAD_CONCURRENCY=1
# Necessário somente para GCS; use Application Default Credentials.
# GCS_BUCKET=nome-do-bucket-privado
NODE_ENV=development
# SOFFICE_PATH=/usr/bin/soffice
