# Copie para .env.production; nunca versione os valores reais.
DOMAIN=app.seu-dominio.com.br
# Se a senha contiver $, envolva o valor em aspas simples para evitar interpolação.
POSTGRES_PASSWORD=
WEB_REPO=../stg-system-web
CORS_ALLOW_ALL_ORIGINS=false
STORAGE_WRITE_BACKEND=local
STORAGE_READ_BACKENDS=local
# Piloto: banco e mídia nos volumes locais da VPS; nenhum serviço externo.
